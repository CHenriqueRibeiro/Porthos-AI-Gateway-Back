{
  "info": {
    "name": "LLM Gateway API",
    "description": "Colecao atualizada a partir do codigo em src/routes e src/services. Base local: {{baseUrl}}. Use /auth/register ou /auth/login para obter auth.accessToken e configure a variavel accessToken. A maioria das rotas usa Authorization: Bearer {{accessToken}}. Rotas publicas: /health, /auth/register, /auth/login e /public/*. Admin usa x-admin-secret.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3333" },
    { "key": "accessToken", "value": "" },
    { "key": "apiKeyId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "providerKeyId", "value": "" },
    { "key": "adminSecret", "value": "" },
    { "key": "email", "value": "user@example.com" },
    { "key": "password", "value": "senha-segura" }
  ],
  "item": [
    {
      "name": "00 Publico",
      "description": "Sem Bearer.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Retorna status do servico."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nome do Cliente\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"planCode\": \"free\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Cria usuario, tenant, API key gateway e assinatura. planCode deve existir no catalogo ativo: free, starter, growth, pro ou scale."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Retorna user, apiKey, apiKeys, subscription e auth.accessToken."
          }
        },
        {
          "name": "Public plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/public/plans",
            "description": "Catalogo publico runtime com planos e addons."
          }
        },
        {
          "name": "Public simulate plan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planCode\": \"starter\",\n  \"addonCodes\": [\"cache_starter_plus\"],\n  \"overrides\": {\n    \"historico_operacional\": \"dias_60\"\n  }\n}"
            },
            "url": "{{baseUrl}}/public/plans/simulate",
            "description": "Simula plano + addons + overrides. Overrides invalidos sao ignorados na simulacao publica."
          }
        },
        {
          "name": "Public recommend plan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estimatedRequestsPerMonth\": 8000,\n  \"wantsManaged\": false,\n  \"wantsAdvancedRetention\": false,\n  \"wantsLargerSemanticBase\": false\n}"
            },
            "url": "{{baseUrl}}/public/plans/recommend",
            "description": "Recomenda um planCode atual e retorna a simulacao do plano."
          }
        }
      ]
    },
    {
      "name": "01 Auth",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Logout stateless. Retorna { success: true }."
          }
        }
      ]
    },
    {
      "name": "02 Conta e API keys",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "List API keys",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/apikeys?highlightApiKeyId={{apiKeyId}}",
            "description": "Lista chaves do usuario autenticado. Query highlightApiKeyId e opcional."
          }
        },
        {
          "name": "Create API key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/apikeys",
            "description": "Cria nova API key gateway respeitando o limite do plano atual."
          }
        },
        {
          "name": "Create legacy user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"outro@example.com\",\n  \"name\": \"Outro Usuario\"\n}"
            },
            "url": "{{baseUrl}}/users",
            "description": "Rota legada protegida por JWT."
          }
        }
      ]
    },
    {
      "name": "03 Sessoes e mensagens",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKeyId\": \"{{apiKeyId}}\",\n  \"externalConversationId\": \"front-conv-001\",\n  \"channel\": \"web\",\n  \"label\": \"Atendimento inicial\"\n}"
            },
            "url": "{{baseUrl}}/sessions",
            "description": "Cria sessao no schema do tenant. apiKeyId e opcional; omitindo usa a chave gateway mais antiga. externalConversationId reutiliza a sessao existente se ja houver uma igual para a API key."
          }
        },
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sessions?page=1&pageSize=20&status=active&apiKeyId={{apiKeyId}}",
            "description": "Query: page, pageSize, status e apiKeyId. apiKeyId e opcional."
          }
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sessions/{{sessionId}}",
            "description": "Retorna a sessao e mensagens."
          }
        },
        {
          "name": "Close session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sessions/{{sessionId}}/close",
            "description": "Marca status como closed."
          }
        },
        {
          "name": "Create message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"role\": \"user\",\n  \"content\": \"Ola, preciso de ajuda.\"\n}"
            },
            "url": "{{baseUrl}}/messages",
            "description": "Cria mensagem manual na sessao. Evite usar junto com /chat se nao quiser duplicar historico."
          }
        },
        {
          "name": "List session messages",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sessions/{{sessionId}}/messages",
            "description": "Lista mensagens em ordem cronologica."
          }
        }
      ]
    },
    {
      "name": "04 LLM",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Responda em uma frase.\" }\n  ],\n  \"temperature\": 0.2,\n  \"max_tokens\": 300,\n  \"debug\": true\n}"
            },
            "url": "{{baseUrl}}/chat",
            "description": "Requer provider key default para o provider do modelo. Modelos usam prefixo openai/, anthropic/ ou gemini/. Retorno segue formato compativel com chat.completion."
          }
        },
        {
          "name": "Extract JSON object",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Extraia nome e data deste texto: Joao assinou em 2026-05-03.\" }\n  ],\n  \"response_format\": { \"type\": \"json_object\" },\n  \"extraction_profile\": \"generic_document\",\n  \"temperature\": 0.2,\n  \"max_tokens\": 500\n}"
            },
            "url": "{{baseUrl}}/extract",
            "description": "response_format e obrigatorio. Aceita json_object ou json_schema."
          }
        },
        {
          "name": "Extract JSON schema",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Contrato assinado por Maria em 2026-05-03 no valor de R$ 1200.\" }\n  ],\n  \"response_format\": {\n    \"type\": \"json_schema\",\n    \"json_schema\": {\n      \"name\": \"contract_extract\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"nome\": { \"type\": \"string\" },\n          \"data\": { \"type\": \"string\" },\n          \"valor\": { \"type\": \"string\" }\n        },\n        \"required\": [\"nome\", \"data\"]\n      }\n    }\n  },\n  \"extraction_profile\": \"generic_document\",\n  \"temperature\": 0.2,\n  \"max_tokens\": 500\n}"
            },
            "url": "{{baseUrl}}/extract",
            "description": "json_schema exige name e schema. O numero de campos e limitado pelo plano."
          }
        }
      ]
    },
    {
      "name": "05 Provider keys",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "List provider keys",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/provider-keys?apiKeyId={{apiKeyId}}",
            "description": "Lista chaves de provedor vinculadas a uma API key gateway."
          }
        },
        {
          "name": "Create provider key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"openai\",\n  \"apiKey\": \"sk-...\",\n  \"label\": \"OpenAI principal\",\n  \"isDefault\": true\n}"
            },
            "url": "{{baseUrl}}/provider-keys?apiKeyId={{apiKeyId}}",
            "description": "Valida a chave no provider antes de salvar. provider: openai, anthropic ou gemini."
          }
        },
        {
          "name": "Set provider key default",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/provider-keys/{{providerKeyId}}/default?apiKeyId={{apiKeyId}}",
            "description": "Define uma provider key como default para a API key gateway."
          }
        },
        {
          "name": "Delete provider key",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/provider-keys/{{providerKeyId}}?apiKeyId={{apiKeyId}}",
            "description": "Remove/desativa provider key."
          }
        }
      ]
    },
    {
      "name": "06 Billing",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Seed billing catalog",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/billing/seed",
            "description": "Popula planos e addons no banco. Rota protegida por JWT, indicada para setup/admin."
          }
        },
        {
          "name": "List plans and addons",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/plans",
            "description": "Catalogo salvo no banco."
          }
        },
        {
          "name": "Current subscription",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/current?apiKeyId={{apiKeyId}}",
            "description": "Retorna assinatura ativa e effectiveConfig para uma API key gateway."
          }
        },
        {
          "name": "Create or replace subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planCode\": \"starter\",\n  \"addonCodes\": [\"cache_starter_plus\"]\n}"
            },
            "url": "{{baseUrl}}/subscriptions?apiKeyId={{apiKeyId}}",
            "description": "Inativa assinatura anterior e cria nova. Addons devem ser permitidos para o plano e respeitar o budget comercial."
          }
        },
        {
          "name": "Set config override",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"featureKey\": \"cache_inteligente\",\n  \"presetKey\": \"redis_24h_semantic_3d\"\n}"
            },
            "url": "{{baseUrl}}/subscriptions/override?apiKeyId={{apiKeyId}}",
            "description": "Aplica override de feature na assinatura ativa. featureKey e presetKey devem existir em src/config/billingCatalog.js."
          }
        }
      ]
    },
    {
      "name": "07 Analytics e dashboard",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Usage by API key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usage/{{apiKeyId}}?includeDaily=true",
            "description": "Query opcional: day=YYYY-MM-DD ou startDate/endDate, includeDaily=true. apiKeyId precisa pertencer ao usuario."
          }
        },
        {
          "name": "Dashboard overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/dashboard?includeDaily=true",
            "description": "Consolida uso de todas as API keys do usuario autenticado."
          }
        }
      ]
    },
    {
      "name": "08 Model pricing",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "List model pricing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/model-pricing",
            "description": "Lista precos por provider/model."
          }
        },
        {
          "name": "Upsert model pricing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"openai\",\n  \"model\": \"gpt-4o-mini\",\n  \"inputPer1k\": 0.00015,\n  \"outputPer1k\": 0.0006,\n  \"currency\": \"USD\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/model-pricing",
            "description": "Cria ou atualiza preco. inputPer1k e outputPer1k devem ser numeros."
          }
        }
      ]
    },
    {
      "name": "09 Admin",
      "description": "Sem Bearer. Usa header x-admin-secret.",
      "item": [
        {
          "name": "Run maintenance",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-admin-secret", "value": "{{adminSecret}}" }],
            "url": "{{baseUrl}}/admin/maintenance/run",
            "description": "Executa manutencao global. Requer ADMIN_MAINTENANCE_SECRET no servidor."
          }
        }
      ]
    }
  ]
}
