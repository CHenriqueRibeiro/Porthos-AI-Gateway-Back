model ModelPricing {
  id          String   @id @default(uuid())
  provider    String
  model       String
  inputPer1k  Float
  outputPer1k Float
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, model])
  @@index([provider, model])
}

model SubscriptionPlan {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  type           String
  priceCents     Int
  currency       String              @default("BRL")
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  featurePresets PlanFeaturePreset[]
  subscriptions  CustomerSubscription[]
}

model PlanFeaturePreset {
  id         String           @id @default(uuid())
  planId     String
  featureKey String
  presetKey  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  plan       SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([planId, featureKey])
  @@index([planId])
}

model AddonCatalog {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  featureKey     String
  presetKey      String
  priceCents     Int
  currency       String          @default("BRL")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customerAddons CustomerAddon[]
}

model CustomerSubscription {
  id              String                 @id @default(uuid())
  apiKeyId        String
  planId          String
  status          String                 @default("active")
  startedAt       DateTime               @default(now())
  renewsAt        DateTime?
  canceledAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  apiKey          ApiKey                 @relation(fields: [apiKeyId], references: [id])
  plan            SubscriptionPlan       @relation(fields: [planId], references: [id])
  addons          CustomerAddon[]
  overrides       CustomerConfigOverride[]

  @@index([apiKeyId, status])
}

model CustomerAddon {
  id              String               @id @default(uuid())
  subscriptionId  String
  addonId         String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  subscription    CustomerSubscription @relation(fields: [subscriptionId], references: [id])
  addon           AddonCatalog         @relation(fields: [addonId], references: [id])

  @@unique([subscriptionId, addonId])
  @@index([subscriptionId])
}

model CustomerConfigOverride {
  id              String               @id @default(uuid())
  subscriptionId  String
  featureKey      String
  presetKey       String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  subscription    CustomerSubscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, featureKey])
  @@index([subscriptionId])
}
